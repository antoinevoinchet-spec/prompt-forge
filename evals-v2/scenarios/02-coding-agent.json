  {"id": "one_block", "what": "exactly one fenced block", "legacy": 3, "type": "blocks", "n": 1},
  {"id": "path", "what": "prompt names src/middleware/session.js", "legacy": 4, "type": "in_prompt", "regex": "src/middleware/session\\.js"},
  {"id": "h_scope", "what": "a Scope lock heading", "legacy": 5, "type": "heading", "term": "Scope lock"},
  {"id": "h_actions", "what": "an Action boundaries heading", "legacy": 6, "type": "heading", "term": "Action boundaries"},
